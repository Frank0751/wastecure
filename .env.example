# Supabase Postgres. Use the pooler URLs from the Supabase "Connect" dialog;
# the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Staff dashboard password (8+ characters). Leave unset to keep it closed.
ADMIN_PASSWORD=""

# Email notifications for form submissions (https://resend.com).
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="WasteCure Website <noreply@wastecure.org>"
EMAIL_TO="wastecureltd@gmail.com"

# Site assistant (https://z.ai). Optional overrides: ZAI_BASE_URL, ZAI_MODEL.
ZAI_API_KEY=""
