# Database URL
# For local development (SQLite):
DATABASE_URL="file:./dev.db"

# For production (Vercel), use one of:
# Option A: Turso (SQLite-compatible, recommended for this project)
#   1. Create account at https://turso.tech
#   2. Create a database: turso db create wastecure
#   3. Get URL: turso db show wastecure --url
#   4. Get token: turso db tokens create wastecure
#   Then set:
#   DATABASE_URL="libsql://wastecure-xxx.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-token"
#   And change prisma/schema.prisma provider from "sqlite" to "libsql"

# Option B: Vercel Postgres (requires Prisma schema changes)
#   DATABASE_URL="postgres://user:pass@host/db"

# Z.AI SDK (for the AI chatbot)
# Get your key from https://z.ai (or https://open.bigmodel.cn)
ZAI_API_KEY="your-zai-api-key"
# Defaults to https://api.z.ai/api/paas/v4 if unset - only override if your
# account uses a different region/endpoint.
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# Defaults to glm-4.5-flash (free tier). Paid models (glm-4.5, glm-4-plus)
# require a funded account or they return HTTP 429.
ZAI_MODEL="glm-4.5-flash"

# Optional: Admin dashboard password
ADMIN_PASSWORD="wastecure2024"

# Email delivery for contact/pickup/volunteer/newsletter notifications
# 1. Create a free account at https://resend.com
# 2. Verify your sending domain (or use their onboarding@resend.dev for testing)
# 3. Create an API key and set it below
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="WasteCure Website <noreply@wastecure.org>"
EMAIL_TO="wastecureltd@gmail.com"
STAFF_EMAIL="wastecureltd@gmail.com"
